package {{.PackageName}}

import (
	"context"
	"errors"
	"testing"

	"gorm.io/gorm"
)

// fakeRepo is a hand-rolled in-memory {{.EntityName}}Repository for unit tests.
// Replace with a mockery-generated mock for full coverage of edge cases.
type fakeRepo struct {
	items   map[uint]*{{.EntityName}}
	nextID  uint
	failOn  string // method name to simulate an error on
}

func newFakeRepo() *fakeRepo { return &fakeRepo{items: map[uint]*{{.EntityName}}{}} }

func (f *fakeRepo) Create(_ context.Context, m *{{.EntityName}}) error {
	if f.failOn == "Create" {
		return errors.New("create failed")
	}
	f.nextID++
	m.ID = f.nextID
	f.items[m.ID] = m
	return nil
}

func (f *fakeRepo) GetByID(_ context.Context, id uint) (*{{.EntityName}}, error) {
	if f.failOn == "GetByID" {
		return nil, errors.New("get failed")
	}
	m, ok := f.items[id]
	if !ok {
		return nil, gorm.ErrRecordNotFound
	}
	return m, nil
}

func (f *fakeRepo) List(_ context.Context, _, _ int) ([]{{.EntityName}}, int64, error) {
	if f.failOn == "List" {
		return nil, 0, errors.New("list failed")
	}
	out := make([]{{.EntityName}}, 0, len(f.items))
	for _, m := range f.items {
		out = append(out, *m)
	}
	return out, int64(len(out)), nil
}

func (f *fakeRepo) Update(_ context.Context, m *{{.EntityName}}) error {
	if f.failOn == "Update" {
		return errors.New("update failed")
	}
	f.items[m.ID] = m
	return nil
}

func (f *fakeRepo) Delete(_ context.Context, id uint) error {
	if f.failOn == "Delete" {
		return errors.New("delete failed")
	}
	delete(f.items, id)
	return nil
}

func TestService_Create(t *testing.T) {
	svc := NewService(newFakeRepo())
	res, err := svc.Create(context.Background(), Create{{.EntityName}}Request{})
	if err != nil {
		t.Fatalf("Create: %v", err)
	}
	if res == nil || res.ID == 0 {
		t.Fatalf("expected response with ID, got %+v", res)
	}
}

func TestService_GetByID_NotFound(t *testing.T) {
	svc := NewService(newFakeRepo())
	_, err := svc.GetByID(context.Background(), 999)
	if err == nil {
		t.Fatal("expected not-found error")
	}
}

func TestService_GetByID_Found(t *testing.T) {
	repo := newFakeRepo()
	svc := NewService(repo)
	res, err := svc.Create(context.Background(), Create{{.EntityName}}Request{})
	if err != nil {
		t.Fatal(err)
	}
	got, err := svc.GetByID(context.Background(), res.ID)
	if err != nil {
		t.Fatalf("GetByID: %v", err)
	}
	if got.ID != res.ID {
		t.Errorf("got ID %d, want %d", got.ID, res.ID)
	}
}

func TestService_Delete(t *testing.T) {
	repo := newFakeRepo()
	svc := NewService(repo)
	res, _ := svc.Create(context.Background(), Create{{.EntityName}}Request{})
	if err := svc.Delete(context.Background(), res.ID); err != nil {
		t.Fatal(err)
	}
	if err := svc.Delete(context.Background(), res.ID); err == nil {
		t.Fatal("expected not-found on second delete")
	}
}
