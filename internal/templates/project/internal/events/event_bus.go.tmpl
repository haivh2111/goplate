// Package events implements a synchronous in-process event bus.
package events

import "sync"

// HandlerFunc is the signature subscribers register with the bus.
type HandlerFunc func(payload any)

// Bus is a simple thread-safe pub/sub bus.
type Bus struct {
	mu   sync.RWMutex
	subs map[string][]HandlerFunc
}

// NewBus constructs an empty Bus.
func NewBus() *Bus { return &Bus{subs: map[string][]HandlerFunc{}} }

// Subscribe registers fn for events published under topic.
func (b *Bus) Subscribe(topic string, fn HandlerFunc) {
	b.mu.Lock()
	defer b.mu.Unlock()
	b.subs[topic] = append(b.subs[topic], fn)
}

// Publish invokes every handler registered for topic synchronously.
// Handlers run in registration order.
func (b *Bus) Publish(topic string, payload any) {
	b.mu.RLock()
	handlers := append([]HandlerFunc(nil), b.subs[topic]...)
	b.mu.RUnlock()
	for _, fn := range handlers {
		fn(payload)
	}
}
