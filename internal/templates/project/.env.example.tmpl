# ── Application ──────────────────────────────
APP_PORT=8080
APP_ENV=development        # development | production

# ── Database ──────────────────────────────────
{{- if eq .DBDriver "sqlite"}}
DB_PATH=app.db
{{- else}}
DB_HOST=localhost
DB_PORT={{if eq .DBDriver "postgres"}}5432{{else}}3306{{end}}
DB_USER={{if eq .DBDriver "postgres"}}postgres{{else}}root{{end}}
DB_PASSWORD=secret
DB_NAME={{.ProjectName}}
{{- end}}

# ── JWT ───────────────────────────────────────
JWT_SECRET=change-me-in-production
JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=168h
